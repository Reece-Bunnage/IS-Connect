# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API (or the "Connect" button).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only needed for `npm run db:setup` (Connect -> Session pooler). Put the real one in .env.local, never here.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
